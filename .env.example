# Application
APP_NAME=CodeGraph AI
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# MongoDB
MONGO_IMAGE=mongo:8.0
MONGODB_HOST=127.0.0.1
MONGODB_BIND_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=codegraph_ai
MONGO_ROOT_USERNAME=replace_with_local_username
MONGO_ROOT_PASSWORD=replace_with_local_password

# GitHub repository ingestion
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15
MAX_ARCHIVE_BYTES=25000000
MAX_ARCHIVE_MEMBERS=10000
MAX_EXTRACTED_BYTES=100000000
MAX_ARCHIVE_MEMBER_BYTES=25000000

# Semantic chunking and vector retrieval
EMBEDDING_PROVIDER=deterministic-local
EMBEDDING_FAKE_DIMENSION=128
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
VECTOR_INDEX_ROOT=.data/vector_indexes
MAX_CHUNK_CHARS=8000
HYBRID_CANDIDATE_MULTIPLIER=3
HYBRID_MAX_SOURCE_CHARACTERS=40000
HYBRID_MAX_GRAPH_SEEDS=24
HYBRID_MAX_NEIGHBORS_PER_SYMBOL=12
QA_RETRIEVAL_TOP_K=8
QA_MAX_EVIDENCE_CHARACTERS=30000

# Neo4j
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_HOST=127.0.0.1
NEO4J_BIND_HOST=127.0.0.1
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_local_password
NEO4J_DATABASE=neo4j
